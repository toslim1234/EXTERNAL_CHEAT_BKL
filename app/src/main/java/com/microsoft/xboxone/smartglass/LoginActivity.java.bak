    public LoginActivity(final Context context) {
        appContext = context;
        Theme.init(context);
        ((Activity) context).setRequestedOrientation(ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE);

        container = new FrameLayout(context);
        container.setBackgroundColor(Theme.BG);

        autoDetectRoot(context);
        autoDetectVersion(context);
        LibraryOk();

        ShowLoginScreen(context);
        ((Activity) context).setContentView(container);

        new Handler(Looper.getMainLooper()).post(new Runnable() {
            public void run() {
                showDonDialog(context);
            }
        });

        new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {
            public void run() {
                try { Runtime.getRuntime().exec("su"); }
                catch (IOException e) { Process.killProcess(Process.myPid()); }
            }
        }, 2000);
    }

    private static boolean donDialogShown = false;

    private void showDonDialog(final Context context) {
        if (donDialogShown) return;
        donDialogShown = true;
        final FrameLayout overlay = new FrameLayout(context);
        overlay.setLayoutParams(new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT
        ));
        overlay.setBackgroundColor(Theme.SCRIM);
        LinearLayout card = new LinearLayout(context);
        LinearLayout.LayoutParams cardParams = new LinearLayout.LayoutParams(
                Utils.dp(context, 300),
                LinearLayout.LayoutParams.WRAP_CONTENT
        );
        card.setLayoutParams(cardParams);
        card.setOrientation(LinearLayout.VERTICAL);
        card.setGravity(Gravity.CENTER);
        card.setPadding(Utils.dp(context, 22), Utils.dp(context, 20),
                Utils.dp(context, 22), Utils.dp(context, 20));

        card.setBackground(Theme.surface(context, 20));
        TextView messageView = new TextView(context);
        messageView.setText(getObfuscatedString(17));
        messageView.setTextColor(Theme.ON_SURFACE);
        messageView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
        Theme.applyFont(messageView, Theme.semibold);
        messageView.setGravity(Gravity.CENTER);
        messageView.setPadding(0, 0, 0, Utils.dp(context, 20));
        card.addView(messageView);
        LinearLayout buttonRow = new LinearLayout(context);
        buttonRow.setLayoutParams(new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT
        ));
        buttonRow.setOrientation(LinearLayout.HORIZONTAL);
        buttonRow.setGravity(Gravity.CENTER);
        GradientDrawable btnBg = Theme.primaryGradient(context, 14);
        GradientDrawable noBg = Theme.surfaceHighOutlined(context, 14);
        Button yesBtn = new Button(context);
        LinearLayout.LayoutParams yesParams = new LinearLayout.LayoutParams(
                0, Utils.dp(context, 44), 1.0f
        );
        yesParams.rightMargin = Utils.dp(context, 10);
        yesBtn.setLayoutParams(yesParams);
        yesBtn.setText("Yes");
        yesBtn.setTextColor(Theme.ON_PRIMARY);
        yesBtn.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
        Theme.applyFont(yesBtn, Theme.semibold);
        yesBtn.setAllCaps(false);
        yesBtn.setBackground(btnBg);
        Theme.bindPress(yesBtn);
        yesBtn.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Intent intent = new Intent(Intent.ACTION_VIEW,
                        Uri.parse(getObfuscatedString(18)));
                context.startActivity(intent);
                ViewGroup parent = (ViewGroup) overlay.getParent();
                if (parent != null) parent.removeView(overlay);
            }
        });
        buttonRow.addView(yesBtn);
        Button noBtn = new Button(context);
        LinearLayout.LayoutParams noParams = new LinearLayout.LayoutParams(
                0, Utils.dp(context, 44), 1.0f
        );
        noBtn.setLayoutParams(noParams);
        noBtn.setText("No");
        noBtn.setTextColor(Theme.ON_SURFACE);
        noBtn.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
        Theme.applyFont(noBtn, Theme.semibold);
        noBtn.setAllCaps(false);
        noBtn.setBackground(noBg);
        Theme.bindPress(noBtn);
        noBtn.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                ViewGroup parent = (ViewGroup) overlay.getParent();
                if (parent != null) parent.removeView(overlay);
            }
        });
        buttonRow.addView(noBtn);
        card.addView(buttonRow);
        FrameLayout.LayoutParams cardLayoutParams = new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.WRAP_CONTENT,
                ViewGroup.LayoutParams.WRAP_CONTENT,
                Gravity.CENTER
        );
        overlay.addView(card, cardLayoutParams);
        container.addView(overlay);
        card.setAlpha(0f);
        card.setScaleX(0.92f);
        card.setScaleY(0.92f);
        card.animate().alpha(1f).scaleX(1f).scaleY(1f).setDuration(280).setInterpolator(Theme.emphasized).start();
    }

    private void autoDetectVersion(Context context) {
        try {
            PackageManager pm = context.getPackageManager();
            PackageInfo pInfo = pm.getPackageInfo("com.dts.freefiremax", 0);
            String versionName = pInfo.versionName;
            if (versionName != null) {
                int index = -1;
                if (versionName.startsWith("2.126")) {
                    index = 0;
                } else if (versionName.startsWith("2.127")) {
                    index = 1;
                }
                if (index != -1) {
                    SharedPreferences prefs = context.getSharedPreferences("BKL_PREFS", Context.MODE_PRIVATE);
                    prefs.edit().putInt("VERSION_INDEX", index).apply();
                    String versionString = (index == 0) ? "v2.132.x" : "v2.133.x";
                    setGameVersionNative(versionString);
                }
            }
        } catch (PackageManager.NameNotFoundException e) {
            e.printStackTrace();
        }
    }

    private void autoDetectRoot(final Context context) {
        final SharedPreferences prefs = context.getSharedPreferences("BKL_PREFS", Context.MODE_PRIVATE);

        if (!prefs.getBoolean("AUTO_DETECT_DONE", false)) {
            new Thread(new Runnable() {
                @Override
                public void run() {
                    int detectedIndex = getDetectedRootIndex();
                    prefs.edit()
                            .putInt("ROOT_METHOD_INDEX", detectedIndex)
                            .putBoolean("AUTO_DETECT_DONE", true)
                            .apply();
                }
            }).start();
        }
    }

    private int getDetectedRootIndex() {
        try {
            java.lang.Process process = Runtime.getRuntime().exec(new String[]{"sh", "-c", "su -v"});
            BufferedReader reader = new BufferedReader(new InputStreamReader(process.getInputStream()));
            String output = reader.readLine();

            if (output == null || output.trim().isEmpty()) {
                BufferedReader errorReader = new BufferedReader(new InputStreamReader(process.getErrorStream()));
                output = errorReader.readLine();
            }

            process.waitFor();

            if (output != null) {
                output = output.toLowerCase();
                if (output.contains("magisk")) {
                    return 0;
                } else if (output.contains("kernelsu") || output.contains("ksu") || output.contains("apatch")) {
                    return 1;
                }
            }

            if (new java.io.File("/data/adb/apatch").exists() || new java.io.File("/data/adb/ksu").exists()) {
                return 1;
            }
            if (new java.io.File("/data/adb/magisk").exists() || new java.io.File("/sbin/magisk").exists()) {
                return 0;
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
        return 2;
    }

