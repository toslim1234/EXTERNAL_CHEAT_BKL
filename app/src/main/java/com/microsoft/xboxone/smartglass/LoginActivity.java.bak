    private View createSocialIconButton(final Context context, String iconName, final String url) {
        ImageButton btn = new ImageButton(context);
        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(Utils.dp(context, 42), Utils.dp(context, 42));
        params.setMargins(Utils.dp(context, 8), 0, Utils.dp(context, 8), 0);
        btn.setLayoutParams(params);
        btn.setBackground(Theme.surfaceHigh(context, 21));
        Theme.bindPress(btn, 0.9f);

        int resId = context.getResources().getIdentifier(iconName, "drawable", context.getPackageName());
        if (resId != 0) {
            btn.setImageResource(resId);
        }

        int padding = Utils.dp(context, 10);
        btn.setPadding(padding, padding, padding, padding);
        btn.setScaleType(ImageView.ScaleType.FIT_CENTER);

        btn.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Intent intent = new Intent(Intent.ACTION_VIEW);
                intent.setData(Uri.parse(url));
                context.startActivity(intent);
            }
        });
        return btn;
    }

    public static void showNotification(final Context context, final String message, final boolean isError) {
        if (context instanceof Activity) {
            ((Activity) context).runOnUiThread(new Runnable() {
                @Override
                public void run() {
                    if (notificationView != null) {
                        notificationView.setBackground(Theme.outlined(context, isError ? Theme.ERROR_TRANSLUCENT : Theme.SUCCESS_TRANSLUCENT, isError ? Theme.ERROR : Theme.SUCCESS, 12));
                        notificationView.setText(message);
                        notificationView.setTextColor(isError ? Theme.ERROR : Theme.SUCCESS);
                        notificationView.setPadding(Utils.dp(context, 12), Utils.dp(context, 8), Utils.dp(context, 12), Utils.dp(context, 8));
                        Theme.fadeIn(notificationView, 0, 250);
                    }
                }
            });
        }
    }

    public static void showProgressBar(boolean show) {
        if (appContext == null) return;
        if (show) {
            if (progressDialog == null) {
                progressDialog = new ProgressDialog(appContext);
                progressDialog.setMessage(getObfuscatedString(15));
                progressDialog.setCancelable(false);
                progressDialog.setIndeterminate(true);
            }
            progressDialog.show();
        } else {
            if (progressDialog != null && progressDialog.isShowing()) {
                progressDialog.dismiss();
                progressDialog = null;
            }
        }
        if (loginButton != null) {
            loginButton.setEnabled(!show);
        }
    }

    public static void ShowInfoBox(Context context, String message, String level) {
        showNotification(context, message, level.equalsIgnoreCase("Error") || level.equalsIgnoreCase("Warning"));
    }

    public static void ShowInfoBox2(Context context, String message, String level) {
        showNotification(context, message, level.equalsIgnoreCase("Error") || level.equalsIgnoreCase("Warning"));
    }

    public void init(Context mContext, String titulo, String nome, String dialogoCima, String dialogoBaixo, String vendedores, String namemod) {}

    private void LibraryOk() {
        try {
            java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.FileReader("/proc/self/maps"));
            String line;
            boolean foundUnauthorized = false;
            while ((line = reader.readLine()) != null) {
                if (line.endsWith(".so")) {
                    if (line.contains("/data/app/") || line.contains("/data/data/") || line.contains("/data/user/")) {
                        if (!line.contains("libcnative.so") && !line.contains("base.apk")) {
                            foundUnauthorized = true;
                            break;
                        }
                    }
                }
            }
            reader.close();
            if (foundUnauthorized) {
                android.os.Process.killProcess(android.os.Process.myPid());
            }
        } catch (Exception e) {
        }
    }
}
